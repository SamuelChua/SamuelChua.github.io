---
layout: default
---
<article class="project-detail">
  <nav class="project-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ '/projects/' | relative_url }}">Projects</a>
    <span aria-hidden="true"> / </span>
    <span>{{ page.title }}</span>
  </nav>
  <header class="project-detail-header">
    <p class="project-eyebrow">{{ page.category }}</p>
    <h1>{{ page.title }}</h1>
    <p class="project-summary">{{ page.summary }}</p>
  </header>
  <div class="project-detail-body">{{ content }}</div>
  <p class="mt-5"><a href="{{ '/projects/' | relative_url }}">← All projects</a></p>
</article>
